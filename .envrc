watch_file shell.nix clang.nix "$HOME/.panthera.nix" $(find nix -name "*.nix" -printf '%p ')

# `use nix` captures the environment from inside nix-shell, where TMPDIR,
# TMP, TEMP, TEMPDIR and NIX_BUILD_TOP point at a /tmp/nix-shell-* directory
# that nix-shell deletes as soon as it exits. Restore the values they had
# before `use nix` so mktemp and anything else that writes to TMPDIR work.
nix_shell_temp_vars=(TMPDIR TMP TEMP TEMPDIR NIX_BUILD_TOP)
for var in "${nix_shell_temp_vars[@]}"; do
  if [[ -n ${!var+set} ]]; then
    printf -v "saved_$var" '%s' "${!var}"
  fi
done

use nix

for var in "${nix_shell_temp_vars[@]}"; do
  saved="saved_$var"
  if [[ -n ${!saved+set} ]]; then
    export "$var=${!saved}"
  else
    unset "$var"
  fi
  unset "$saved"
done
unset nix_shell_temp_vars var saved
